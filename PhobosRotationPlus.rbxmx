			<Item class="ModuleScript" referent="RBXD72DF91FC7394795B07E03041FBAB9C8">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local class = {}

local moon = _G.MoonGlobal
local moonHelper = require("../Utils/MoonHelper")

class.inheriteTrack = {}
local EditingTargets = {}


function class.addTrack(track)
	if not table.find(class.inheriteTrack, track) then
		table.insert(class.inheriteTrack, track)
	end
end

function class.addOrRemoveTrack(track)
	local find = table.find(class.inheriteTrack, track)
	if not find then
		table.insert(class.inheriteTrack, track)
	else
		table.remove(class.inheriteTrack, find)
	end
end

function getInitialData(KeyframeTrack)
	if moon.objIsType(KeyframeTrack, "MotorTrack") then
		return {
			ini_transform = KeyframeTrack.Target.C1,
			ini_cf = KeyframeTrack.Target.Part1.CFrame,
			Track = KeyframeTrack,
		}
	elseif moon.objIsType(KeyframeTrack, "BoneTrack") then
		return {
			ini_transform = KeyframeTrack.Target.Transform,
			ini_cf = KeyframeTrack.Target.WorldCFrame,
			Track = KeyframeTrack,
		}
	elseif KeyframeTrack.part then
		return {
			ini_transform = KeyframeTrack.part.CFrame,
			ini_cf = KeyframeTrack.part.CFrame,
			Track = KeyframeTrack,
		}
	end
	return
end

function class.setEditingCFrame(tracks)
	table.clear(EditingTargets)
	for _, KeyframeTrack in class.inheriteTrack do
		local init = getInitialData(KeyframeTrack)
		table.insert(EditingTargets, init)
		moonHelper.addSaveTrack(init)
	end
end

function class.update()
	local allTracks = moonHelper.getSelectedTracks()
	
	for _, tbl in EditingTargets do
		local Track = tbl.Track
		
		if table.find(allTracks, Track) then
			continue
		end
		
		if Track.Target.ClassName == "Motor6D" then			
			local motor : Motor6D = Track.Target

			local rotDelta = (tbl.ini_cf:Inverse() * motor.Part1.CFrame).Rotation

			local default = Track.defaultValue
			local pivot = CFrame.new(default.p)

			local oldC1Local = motor.C1 * default:Inverse()

			motor.C1 =
				(pivot * rotDelta * pivot:Inverse())
				* oldC1Local
				* default
		elseif Track.Target.ClassName == "Bone" then
			local bone: Bone = Track.Target

			local currentWorldRot = bone.WorldCFrame.Rotation

			local compensation =
				currentWorldRot:Inverse() * tbl.ini_cf.Rotation

			bone.Transform = compensation * tbl.ini_transform
		end
	end
end

function class.save()
	moonHelper.saveCurrent(EditingTargets)
end

moonHelper.removeItemObjectConnect(function(removeObject)
	for i, track in class.inheriteTrack do
		if track == removeObject then
			table.remove(class.inheriteTrack, i)
		end
	end
	if removeObject.RigMap then
		for path, track in removeObject.RigMap do
			for i, inherite in class.inheriteTrack do
				if inherite == track then
					table.remove(class.inheriteTrack, i)
				end
			end
		end
	end
end)


return class
]]></ProtectedString>
