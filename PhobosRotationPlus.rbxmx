							<BinaryString name="Tags"></BinaryString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXD64D42A9E92F491A8DDC0448CF93A352">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local store = require(script.Parent.store)
local subscribe = require(script.Parent.subscribe)
local types = require(script.Parent.types)
type Selector<T> = types.Selector<T>

local function noop() end

--[=[
	Creates an instance of `factory` for each item in the atom's state, and
	cleans up the instance when the item is removed. Returns a cleanup function
	that unsubscribes all instances.
	
	@param callback The atom or selector to observe.
	@param factory The function that tracks the lifecycle of each item.
	@return A function that unsubscribes all instances.
]=]
local function observe<K, V>(callback: Selector<{ [K]: V }>, factory: (value: V, key: K) -> (() -> ())?): () -> ()
	local connections: { [K]: () -> () } = {}

	local function listener(state: { [K]: V })
		for key, disconnect in next, connections do
			if state[key] == nil then
				connections[key] = nil
				disconnect()
			end
		end

		for key, value in next, state do
			if not connections[key] then
				connections[key] = factory(value, key) or noop
			end
		end
	end

	local unsubscribe = subscribe(callback, listener)

	store.peek(function(): ()
		listener(callback())
	end)

	return function()
		unsubscribe()
		for _, disconnect in next, connections do
			disconnect()
		end
		table.clear(connections)
	end
end

return observe
]]></ProtectedString>
							<string name="ScriptGuid">{38AA3B51-1D5A-4379-AC7B-5B58547C7C28}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">observe</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX9CA92B3435994F13AE8D5CB2F57FC4C3">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local types = require(script.Parent.types)
type Atom<T> = types.Atom<T>
type Set<T> = types.Set<T>
type WeakMap<K, V> = types.WeakMap<K, V>

local __DEV__ = _G.__DEV__

local listeners: WeakMap<Atom<any>, WeakMap<() -> (), unknown>> = setmetatable({}, { __mode = "k" })

local batched: Set<() -> ()> = {}
local batching = false

local capturing = {
	stack = {} :: { Set<Atom<any>> },
	index = 0,
}

--[=[
	Calls the given function and returns the result. If the function yields or
	throws an error, the thread is closed and an error is thrown. Regardless of
	the outcome, the `finally` function is called to clean up any resources.
	
	@param callback The function to run.
	@param finally Cleanup logic to run before error handling.
	@param ... Arguments to pass to the callback.
	@return The result of the callback.
]=]
local function try<T, U...>(callback: (U...) -> T | any, finally: (() -> ())?, ...: U...): T
	if __DEV__ then
		local thread = coroutine.create(callback)
		local success, result = coroutine.resume(thread, ...)

		if finally then
			finally()
		end

		if coroutine.status(thread) == "suspended" then
			local source, line, name = debug.info(callback, "sln")

			coroutine.close(thread)

			error(
				"Yielding is not allowed in atom functions. Consider wrapping this code in a Promise or task.defer instead."
					.. `\nFunction defined at: {source}:{line}`
					.. if name == "" then "" else ` function {name}`
			)
		elseif not success then
			local source, line, name = debug.info(callback, "sln")

			error(
				"An error occurred while running an atom function"
					.. `\nFunction defined at: {source}:{line}`
					.. (if name == "" then "" else ` function {name}`)
					.. `\nError: {result}`
			)
		end

		return result
	end

	if not finally then
		return callback(...)
	end

	local success, result = pcall(callback, ...)

	finally()
	assert(success, result)

	return result
end

--[=[
	Returns whether the given value is an atom.

	@param value The value to check.
	@return `true` if the value is an atom, otherwise `false`.
]=]
local function isAtom(value: any): boolean
	return not not (value and listeners[value])
end

--[=[
	Notifies all subscribers of the given atom that the state has changed.
	
	@param atom The atom to notify.
]=]
local function notify(atom: Atom<any>)
	if batching then
		for listener in next, listeners[atom] do
			batched[listener] = true
		end
		return
	end

	for listener in next, table.clone(listeners[atom]) do
		try(listener)
	end
end

--[=[
	Returns the result of the function without subscribing to changes. If a
	non-function value is provided, it is returned as is.
	
	@param callback The atom or selector to get the state of.
	@param args Arguments to pass to the function.
	@return The current state.
]=]
local function peek<T, U...>(callback: ((U...) -> T) | T, ...: U...): T
	if type(callback) ~= "function" then
		return callback
	end

	if capturing.index == 0 then
		return callback(...)
	end

	capturing.index += 1
	capturing.stack[capturing.index] = {}

	local result = try(callback, function()
		capturing.stack[capturing.index] = nil
		capturing.index -= 1
	end, ...)

	return result
end

--[=[
	Captures all atoms that are read during the function call and returns them
	along with the result of the function. Useful for tracking dependencies.
	
	@param callback The function to run.
	@return A tuple containing the captured atoms and the result of the function.
]=]
local function capture<T, U...>(callback: (U...) -> T, ...: U...): (Set<Atom<any>>, T)
	-- If the callback is an atom, return it immediately
	if listeners[callback :: any] then
		return { [callback :: any] = true }, peek(callback)
	end

	local dependencies: Set<Atom<any>> = {}

	capturing.index += 1
	capturing.stack[capturing.index] = dependencies

	local result = try(callback, function()
		capturing.stack[capturing.index] = nil
		capturing.index -= 1
	end, ...)

	return dependencies, result
end

--[=[
	Runs the given function and schedules listeners to be notified only once
	after the function has completed. Useful for batching multiple changes.
	
	@param callback The function to run.
]=]
local function batch(callback: () -> ())
	if batching then
		return callback()
	end

	batching = true

	try(callback, function()
		batching = false
	end)

	for listener in next, batched do
		try(listener)
	end

	table.clear(batched)
end

--[=[
	Subscribes the listener to the changes of the given atoms.
	
	@param atoms The atoms to listen to.
	@param listener The function to call when the atoms change.
	@param ref Optionally bind the lifetime of the listener to a value.
]=]
local function connect(atoms: Set<Atom<any>>, listener: () -> (), ref: unknown?)
	for atom in next, atoms do
		listeners[atom][listener] = ref or true
	end
end

--[=[
	Unsubscribes the listener from every atom it was connected to.
	
	@param atoms The atoms to stop listening to.
	@param listener The function to stop calling when the atoms change.
]=]
local function disconnect(atoms: Set<Atom<any>>, listener: () -> ())
	for atom in next, atoms do
		listeners[atom][listener] = nil
	end
end

return {
	listeners = listeners,
	capturing = capturing,
	isAtom = isAtom,
	notify = notify,
	capture = capture,
	batch = batch,
	peek = peek,
	connect = connect,
	disconnect = disconnect,
}
]]></ProtectedString>
							<string name="ScriptGuid">{687586B9-96D2-41C3-84D0-5E28034F8984}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">store</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX3FAFC93DF9A04E94B28E432D9166ACFF">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[local store = require(script.Parent.store)
local types = require(script.Parent.types)
type Selector<T> = types.Selector<T>

--[=[
	Subscribes to changes in the given atom or selector. The callback is
	called with the current state and the previous state immediately after a
	change occurs.
	
	@param callback The atom or selector to subscribe to.
	@param listener The function to call when the state changes.
	@return A function that unsubscribes the callback.
]=]
local function subscribe<T>(callback: Selector<T>, listener: (state: T, prev: T) -> ()): () -> ()
	local dependencies, state = store.capture(callback)
	local disconnected = false

	local function handler()
		local prevState = state

		store.disconnect(dependencies, handler)
		dependencies, state = store.capture(callback)

		if not disconnected then
			store.connect(dependencies, handler)
		end

		if state ~= prevState then
			listener(state, prevState)
		end
	end

	store.connect(dependencies, handler)

	return function()
		if not disconnected then
			disconnected = true
			store.disconnect(dependencies, handler)
		end
	end
end

return subscribe
]]></ProtectedString>
							<string name="ScriptGuid">{A53009DA-17BF-4911-9E5B-FDC33762E826}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">subscribe</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX18562C63CDF54A79B1F57410EB72BF62">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[export type Set<T> = { [T]: true }

export type WeakMap<K, V> = typeof(setmetatable({} :: { [K]: V }, { __mode = "k" }))

--[=[
	A primitive state container that can be read from and written to. When the
	state changes, all subscribers are notified.

	@param state The next state or a function that produces the next state.
	@return The current state, if no arguments are provided.
]=]
export type Atom<T> = (state: (T | (T) -> T)?) -> T

--[=[
	A function that depends on one or more atoms and produces a state. Can be
	used to derive state from atoms.

	@template State The type of the state.
	@return The current state.
]=]
export type Selector<T> = () -> T

--[=[
	Optional configuration for creating an atom.
]=]
export type AtomOptions<T> = {
	--[=[
		A function that determines whether the state has changed. By default,
		a strict equality check (`===`) is used.
	]=]
	equals: (prev: T, next: T) -> boolean,
}

return nil
]]></ProtectedString>
							<string name="ScriptGuid">{ED98DB31-1A31-4766-9C93-BA8CAA771F84}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">types</string>
							<int64 name="SourceAssetId">-1</int64>
							<BinaryString name="Tags"></BinaryString>
						</Properties>
					</Item>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBXD8FB8AAE048B42BDADBF25C2A8653448">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local class = {}

local camera: Camera = workspace.CurrentCamera
local moonHelper = require("./MoonHelper")
local config = require("../Config")

type mouseData = {
	startPos: Vector2,
	currentPos: Vector2,
	startDegree: number,
	currentDegree: number,
	sensitivity: number,
	direction: { string },
}

local function demicalFloor(decimal)
	return math.floor(decimal * 10000) / 10000
end

local function normalize(cframe : CFrame)
	local x,y,z = cframe:ToEulerAnglesXYZ()
	return CFrame.fromEulerAnglesXYZ(demicalFloor(x), demicalFloor(y), demicalFloor(z))
end

function class.rotateVectorWithCamera(camera: Camera, vector)
	local axis, amount = normalize(camera.CFrame):ToAxisAngle()
	return class.rotateVectorAround(vector, amount, axis)
end

function class.rotateVectorAround(v, amount, axis)
	return CFrame.fromAxisAngle(axis, amount):VectorToWorldSpace(v)
end

function class.worldToScreenPoint(center)
	return camera:WorldToScreenPoint(center)
end

function class.degreeAroundCenter(center: Vector3, vec2: Vector2)
	local screenPosition = camera:WorldToScreenPoint(center)

	return math.atan2(vec2.X - screenPosition.X, vec2.Y - screenPosition.Y)
end

function class.angleDiff(a, b)
	return (b - a + math.pi) % (math.pi * 2) - math.pi
end

function class.getOffset(mouseData: mouseData): Vector3
	local vec2Offset = (mouseData.currentPos - mouseData.startPos)

	return Vector3.new(vec2Offset.X, vec2Offset.Y, 0)
end

local function projectToSphere(x, y, radius)
	local mag = x * x + y * y
	local r2 = radius * radius
	if mag <= r2 / 2 then
		return Vector3.new(x, y, math.sqrt(r2 - mag))
	else
		return Vector3.new(x, y, r2 / (2 * math.sqrt(mag)))
	end
end

function class.getLine(PointA, PointB, LineThickness)
	local Distance = math.sqrt(math.pow(PointA.X - PointB.X, 2) + math.pow(PointA.Y - PointB.Y, 2))
	local Center = Vector2.new((PointA.X + PointB.X) / 2, (PointA.Y + PointB.Y) / 2)
	local Rotation = math.atan2(PointA.Y - PointB.Y, PointA.X - PointB.X)

	return {
		Size = UDim2.new(0, Distance, 0, LineThickness),
		Position = UDim2.new(0, Center.X, 0, Center.Y),
		Rotation = math.deg(Rotation),
	}
end

function class.trackballRotation(mouseStart, mouseCurrent, camera, radius, sensitivity)
	local viewportSize = camera.ViewportSize
	local screenCenter = viewportSize / 2

	local scale = math.min(viewportSize.X, viewportSize.Y) / 2

	local sx = (mouseStart.X - screenCenter.X) / scale
	local sy = (screenCenter.Y - mouseStart.Y) / scale

	local cx = (mouseCurrent.X - screenCenter.X) / scale
	local cy = (screenCenter.Y - mouseCurrent.Y) / scale

	local v0 = projectToSphere(sx, sy, radius)
	local v1 = projectToSphere(cx, cy, radius)

	v0 = v0.Unit
	v1 = v1.Unit

	local axis = v0:Cross(v1)
	if axis.Magnitude < 1e-6 then
		return CFrame.identity
	end

	axis = axis.Unit

	local dot = math.clamp(v0:Dot(v1), -1, 1)
	local angle = math.acos(dot) * sensitivity

	axis = camera.CFrame:VectorToWorldSpace(axis)

	return CFrame.fromAxisAngle(axis, angle)
end

local function getSignedAngle(axisVector, angle)
	if camera.CFrame.LookVector:Dot(axisVector) < 0 then
		return -angle
	end
	return angle
end

local function projectMouseToAxis(mouseData, axis: Vector3): Vector3
	local centerWorld = moonHelper.getCenterPosition()
	local centerScreen = camera:WorldToScreenPoint(centerWorld)
	local axisEndScreen = camera:WorldToScreenPoint(centerWorld + axis)

	local screenAxis = Vector2.new(axisEndScreen.X - centerScreen.X, axisEndScreen.Y - centerScreen.Y)

	if screenAxis.Magnitude < 0.001 then
		return Vector3.zero
	end

	screenAxis = screenAxis.Unit

	local mouseDelta = mouseData.currentPos - mouseData.startPos

	local projected = mouseDelta:Dot(screenAxis)

	return axis.Unit * projected
end

local function getConstrainedMovement(mouseData, moveDirection: Vector3): Vector3
	local direction = mouseData.direction

	if not direction or #direction == 3 then
		return moveDirection
	end

	local result = Vector3.zero

	for _, axis in ipairs(direction) do
		if axis == "X" then
			result += projectMouseToAxis(mouseData, Vector3.xAxis)
		elseif axis == "Y" then
			result += projectMouseToAxis(mouseData, Vector3.yAxis)
		elseif axis == "Z" then
			result += projectMouseToAxis(mouseData, Vector3.zAxis)
		end
	end

	return result
end

local cframeConverters = {
	move = function(mouseData)
		local distance = (moonHelper.getCenterPosition() - camera.CFrame.Position).Magnitude

		local vector = class.getOffset(mouseData)
		local fixed_vector = Vector3.new(vector.X, -vector.Y, 0)
		local freeMovement = class.rotateVectorWithCamera(camera, fixed_vector)

		local finalMovement = getConstrainedMovement(mouseData, freeMovement)

		if mouseData.direction and #mouseData.direction > 0 then
			finalMovement = finalMovement * mouseData.sensitivity / 100
			if config.data.move_change_sensitive.value then
				finalMovement = finalMovement * distance * 0.1
			end
		end

		return CFrame.new(finalMovement)
	end,
	rotate = function(mouseData)
		local radianDiff = class.angleDiff(mouseData.currentDegree, mouseData.startDegree)
		local axis = camera.CFrame.LookVector

		if #mouseData.direction == 1 then
			local axisName = mouseData.direction[1]

			if axisName == "X" then
				local angle = getSignedAngle(Vector3.new(1, 0, 0), radianDiff)
				return CFrame.Angles(angle, 0, 0)
			elseif axisName == "Y" then
				local angle = getSignedAngle(Vector3.new(0, 1, 0), radianDiff)
				return CFrame.Angles(0, angle, 0)
			elseif axisName == "Z" then
				local angle = getSignedAngle(Vector3.new(0, 0, 1), radianDiff)
				return CFrame.Angles(0, 0, angle)
			end
		elseif #mouseData.direction == 2 then
			if not table.find(mouseData.direction, "X") then
				local angle = getSignedAngle(Vector3.new(1, 0, 0), radianDiff)
				return CFrame.Angles(angle, 0, 0)
			elseif not table.find(mouseData.direction, "Y") then
				local angle = getSignedAngle(Vector3.new(0, 1, 0), radianDiff)
				return CFrame.Angles(0, angle, 0)
			elseif not table.find(mouseData.direction, "Z") then
				local angle = getSignedAngle(Vector3.new(0, 0, 1), radianDiff)
				return CFrame.Angles(0, 0, angle)
			end
		end

		return CFrame.fromAxisAngle(axis, radianDiff)
	end,
	ball_rotate = function(mouseData)
		local ball_size = 160

		return class.trackballRotation(
			mouseData.startPos,
			mouseData.currentPos,
			camera,
			ball_size,
			mouseData.sensitivity * ball_size
		)
	end,
}
function class.mouseToCframe(mouseData: mouseData, state): CFrame
	return cframeConverters[state](mouseData)
end

local CURSORS = {
	EW = "rbxasset://SystemCursors/SizeEW",
	NS = "rbxasset://SystemCursors/SizeNS",
	NESW = "rbxasset://SystemCursors/SizeNESW",
	NWSE = "rbxasset://SystemCursors/SizeNWSE",
}

function class.radianToResizeCursor(radian)
	local degree = (math.deg(radian) % 360 + 360) % 360

	local snapped = math.floor((degree + 22.5) / 45) * 45 % 360

	if snapped == 0 or snapped == 180 then
		return CURSORS.EW
	elseif snapped == 90 or snapped == 270 then
		return CURSORS.NS
	elseif snapped == 45 or snapped == 225 then
		return CURSORS.NESW
	else -- 135 or 315
		return CURSORS.NWSE
	end
end

return class
]]></ProtectedString>
					<string name="ScriptGuid">{54A4DCF2-8F55-4DB6-8C02-1BF1E0B01727}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Math</string>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX11793C95F0D44B5EA76FEF1584FED180">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local class = {}

local moon = _G.MoonGlobal

local LayerSystem = moon.Windows.MoonAnimator.g_e.LayerSystem
local LayerHandler = LayerSystem.LayerHandler
local PlaybackHandler = LayerSystem.PlaybackHandler
local SelectionHandler = LayerSystem.SelectionHandler

class.moonUiUnfocus = false

local activate
function class.setActivate(m)
	activate = m
end

local config = require("../Config")
local motionGraph = require("../Helper/MotionGraph")

local pendingUpdate
local function updateMotionDefer(f)
	if pendingUpdate then
		task.cancel(pendingUpdate)
	end

	pendingUpdate = task.defer(function()
		pendingUpdate = nil
		motionGraph.graphCleanup()
		motionGraph.trackDirty = true
		task.spawn(function()
			task.wait()
			motionGraph.updateMotionGraph(f)
		end)
	end)
end

if not SelectionHandler._originalTrackSelectionChanged then
	SelectionHandler._originalTrackSelectionChanged = SelectionHandler.TrackSelectionChanged
end
SelectionHandler.TrackSelectionChanged = function(Track, selected, SelectedTracks)
	SelectionHandler._originalTrackSelectionChanged(Track, selected, SelectedTracks)
	updateMotionDefer()
end

local trackRegisterConnections = {}
if not SelectionHandler._originalRegisterTrack then
	SelectionHandler._originalRegisterTrack = SelectionHandler.RegisterTrack
end
function SelectionHandler:RegisterTrack(Track)
	SelectionHandler._originalRegisterTrack(self, Track)
	for _, callback in trackRegisterConnections do
		callback(Track)
	end
end

function class.registerTrackConnect(f)
	table.insert(trackRegisterConnections, f)
end

local RemoveItemObjectConnections = {}
if not LayerHandler._originalRemoveItemObject then
	LayerHandler._originalRemoveItemObject = LayerHandler.RemoveItemObject
end
function LayerHandler:RemoveItemObject(Object)
	for _, callback in RemoveItemObjectConnections do
		callback(Object)
	end
	LayerHandler._originalRemoveItemObject(self, Object)
end

function class.removeItemObjectConnect(f)
	table.insert(RemoveItemObjectConnections, f)
end

config.data.motion_graph_enable:onChange(updateMotionDefer)
config.data.pivot_point:onChange(updateMotionDefer)
config.data.show_only_nearby:onChange(updateMotionDefer)
config.data.nearby_range:onChange(updateMotionDefer)
config.data.curve_mode:onChange(updateMotionDefer)

function class.getItemMap()
	return LayerHandler.ItemMap
end

function class.getActions()
	return moon.Input.Actions
end

function class.getAllItems()
	local trackItems = {}
	LayerHandler.LayerContainer:Iterate(function(Track)
		Track.TrackItems:Iterate(function(TrackItem)
			table.insert(trackItems, TrackItem)
		end)
	end, "Track")
	return trackItems
end

function class.getAllTracksInfo()
	local allTracks = class.getItemMap()
	local tracks = {}
	for id, track in allTracks do
		local name = track.Path:GetItem().Name
		tracks[name] = {}
		for path, i in track.RigMap do
			table.insert(tracks[name], name .. "." .. i.name)
		end
	end
	return tracks
end

function class.getTrackRig(track)
	if track.Path then
		local current = track.Path.Item
		while current ~= nil do
			--print(current, moon.CheckIfRig(current))
			if moon.CheckIfRig(current) then
				return current
			end

			if current.ClassName == "DataModel" then
				current = nil
			else
				current = current.Parent
			end
		end
	end
end

function class.getAllTracks()
	local allTracks = class.getItemMap()
	local tracks = {}
	for id, rig in allTracks do
		for path, track in rig.RigMap do
			table.insert(tracks, track)
		end
	end
	return tracks
end

function class.getParentTrack(track) end

local EditingTargets = {}

function class.getEditingTargets()
	return EditingTargets
end

function class.getInitialData(KeyframeTrack)
	if moon.objIsType(KeyframeTrack, "MotorTrack") then
		return {
			ini_transform = KeyframeTrack.Target.C1,
			ini_cf = KeyframeTrack.Target.Part1.CFrame,
			ini_center = (KeyframeTrack.Target.Part1.CFrame * KeyframeTrack.defaultValue).p,
			Track = KeyframeTrack,
		}
	elseif moon.objIsType(KeyframeTrack, "BoneTrack") then
		return {
			ini_transform = KeyframeTrack.Target.Transform,
			ini_cf = KeyframeTrack.Target.TransformedWorldCFrame,
			ini_center = KeyframeTrack.Target.TransformedWorldCFrame.p,
			Track = KeyframeTrack,
		}
	elseif KeyframeTrack.part then
		return {
			ini_transform = KeyframeTrack.part.CFrame,
			ini_cf = KeyframeTrack.part.CFrame,
			ini_center = KeyframeTrack.part.CFrame.p,
			Track = KeyframeTrack,
		}
	end
	return
end

function class.setEditingCFrame(tracks)
	table.clear(EditingTargets)
	if tracks then
		for _, KeyframeTrack in tracks do
			table.insert(EditingTargets, class.getInitialData(KeyframeTrack))
		end
	else
		SelectionHandler.SelectedTracks:Iterate(function(KeyframeTrack)
			table.insert(EditingTargets, class.getInitialData(KeyframeTrack))
		end, "KeyframeTrack")
	end
end

function class.getCenterPosition()
	local center = Vector3.zero
	local size = 0
	for _, tbl in pairs(EditingTargets) do
		size += 1
		center += tbl.ini_center
	end
	if size > 0 then
		return center / #EditingTargets
	else
		warn("Not found selecting track.")
		return center
	end
end

function class.isPlaying()
	return PlaybackHandler.Playing 
end

function class.play()
	return PlaybackHandler:Play() 
end

function class.stop()
	return PlaybackHandler:Stop() 
end

class.hideUI = false

function class.isUiVisible()
	if not moon.Windows.MoonAnimator.Visible then
		return false
	end
	
	if class.hideUI then
		return false
	end
	
	return moon.Windows.MoonAnimator.UI.Visible
end

function class.allAvailable()
	if not moon.Windows.MoonAnimator.Visible then
		return false
	end
	
	if not moon.Windows.MoonAnimator.Focused and not class.moonUiUnfocus then
		return false
	end

	return true
end

function class.trackAvailable()
	if SelectionHandler.SelectedTracks.size < 1 then
		return false
	end

	return true
end

local function hasProperty(object, prop)
	local t = object[prop] 
end

local unFocusItem = {}
function class.unFocus()
	activate(true)
	--SelectionHandler:_DeselectAllTracks()
	--table.clear(unFocusItem)
	--for _, i in moon.MouseFilter:GetDescendants() do
	--	local success = pcall(function() hasProperty(i, "Visible") end)

	--	if success and i.Visible then
	--		table.insert(unFocusItem, i)
	--		i.Visible = false
	--	end
	--end

	if moon.CurrentWindowFocused then
		moon.CurrentWindowFocused:ReleaseFocus()
	end

	class.moonUiUnfocus = true
	if not config.data.hide_moon_when_tool.value then
		return
	end

	
	moon.Windows.MoonAnimator:SetHidden(true)
end

function class.focus()
	class.moonUiUnfocus = false
	
	--for _, i in unFocusItem do
	--	i.Visible = true
	--end
	
	moon.Windows.MoonAnimator:GetFocus()
	moon.Windows.MoonAnimator:SetHidden(false)
end

function class.iterateTrackItems(func)
	SelectionHandler.SelectedTrackItems:Iterate(func)
end

function class.iterateTrack(func)
	SelectionHandler.SelectedTracks:Iterate(func)
end

function class.getSelectedTracks()
	local tracks = {}
	class.iterateTrack(function(track)
		table.insert(tracks, track)
	end)
	return tracks
end

local saveTracks = {}

function class.addSaveTrack(track)
	if not table.find(saveTracks, track) then
		table.insert(saveTracks, track)
	end
end

local function checkUpdate(FinalTracks, tracks)
	for _, tbl in pairs(tracks) do
		local Track = tbl.Track
		if Track.Target.ClassName == "Motor6D" then
			if Track.Target.C1 ~= tbl.ini_transform then
				table.insert(FinalTracks, Track)
			end
		elseif Track.Target.ClassName == "Bone" then
			if Track.Transform ~= tbl.ini_transform then
				table.insert(FinalTracks, Track)
			end
		else
			if Track:get_prop() ~= tbl.ini_transform then
				table.insert(FinalTracks, Track)
			end
		end
	end
end

function class.saveCurrent(tracks)
	local FinalTracks = {}
	checkUpdate(FinalTracks, tracks or EditingTargets)
	checkUpdate(FinalTracks, saveTracks)
	
	moon.Windows.MoonAnimator.DoCompositeAction("AddToTracks", { Tracks = FinalTracks })
	
	local selects = {}
	for _ , tbl in (tracks or EditingTargets) do
		table.insert(selects, tbl.Track)
	end
	
	class.selectTracks(selects)
	table.clear(saveTracks)
end

function class.previewKeyFrame(cframe: CFrame, name: string?)
	for _, tbl in pairs(EditingTargets) do
		local Track = tbl.Track

		if name and Track.name ~= name then
			continue
		end

		if Track.Target.ClassName == "Motor6D" then
			local pivotCFrame = Track.Target.Part0.CFrame * Track.Target.C0
			local pivotPosition = (tbl.ini_cf * Track.defaultValue).p
			local delta = pivotPosition - pivotCFrame.p
			pivotCFrame = pivotCFrame + delta

			local relativeToPivot = pivotCFrame:toObjectSpace(tbl.ini_cf)
			local newPartCFrame = (cframe * (pivotCFrame - pivotCFrame.p) + pivotCFrame.p):toWorldSpace(relativeToPivot)

			Track.Target.C1 = newPartCFrame:Inverse() * (pivotCFrame - delta)
		elseif Track.Target.ClassName == "Bone" then
			local transformedWorld = tbl.ini_cf
			local newWorldCF = (cframe + transformedWorld.p) * (transformedWorld - transformedWorld.p)
			local transformOffset = transformedWorld:toObjectSpace(newWorldCF)
			Track.Target.Transform = tbl.ini_transform * transformOffset
		else
			local cf = cframe * tbl.ini_transform.Rotation + tbl.ini_transform.Position
			Track:set_prop(cf)
			Track.value = cf
		end
	end
end

function class.setupDefaultKeys ()
	if not moon.Input.defaultkeys then
		moon.Input.defaultkeys = {}
		for name, data in class.getActions() do
			moon.Input.defaultkeys[name] = table.clone(data.keys)
		end
	end
end

function class.getDefaultKeys()
	return moon.Input.defaultkeys
end

function class.nextFrame()
	if PlaybackHandler.Playing then
		PlaybackHandler:Stop()
	end

	local next_frame = math.clamp(LayerSystem.SliderFrame + 1, 0, LayerSystem.length)
	LayerSystem:SetSliderFrame(next_frame)
end

function class.nextPose(track)
	if PlaybackHandler.Playing then
		PlaybackHandler:Stop()
	end

	local find = LayerSystem.length
	for pos, _ in pairs(track.PoseMap or LayerHandler.ActiveItemObject.PoseMap) do
		if pos < find and pos > LayerSystem.SliderFrame then
			find = pos
		end
	end
	LayerSystem:SetSliderFrame(find)
end


function class.clearKeybindUI(name)
	local menu = moon.AllMenuItems[name]
	if menu and menu.control_frame then
		menu:RemovePaintedItem(menu.control_frame.Label)
		menu.control_frame:Destroy()
	end
end

function class.updateControl(name, keys)
	class.clearKeybindUI(name)
	moon.Input:SetActionControls(name, keys)
end

function class.checkDefaultCFrame(target)
	LayerSystem:SetSliderFrame(0)
	local allTracks = class.getAllTracks()
	moon.Windows.MoonAnimator.DoCompositeAction("AddToTracks", { Tracks = allTracks, default = true })
	class.setEditingCFrame()
	print(target.CFrame)
	moon.Input:DoAction("Undo")
end

function class.selectTracks(tracks)
	SelectionHandler:_DeselectAllTracks()
	for _, track in tracks do
		SelectionHandler:_SelectTrack(track)
	end
end

function class.ungroup(trackItems)
	local TargetKeyframes = {}
	local MinBound
	local MaxBound

	for _, Keyframe in trackItems do
		if Keyframe.group then
			if MinBound == nil or Keyframe.frm_pos < MinBound then
				MinBound = Keyframe.frm_pos
			end
			if MaxBound == nil or Keyframe.frm_pos + Keyframe.width > MaxBound then
				MaxBound = Keyframe.frm_pos + Keyframe.width
			end
			table.insert(TargetKeyframes, Keyframe)
		end
	end

	moon.Windows.MoonAnimator.DoCompositeAction(
		"UngroupKeyframes",
		{ TargetKeyframes = TargetKeyframes, minPos = MinBound, maxPos = MaxBound, InRange = true, Delete = false }
	)
	return TargetKeyframes
end

function class.cframe2keyframe(target, mode: "frame" | "pose")
	LayerSystem:SetSliderFrame(0)

	local selectingTrack = class.getSelectedTracks()

	local allTracks = class.getAllTracks()
	local groupTracks = class.ungroup(class.getAllItems())
	moon.Windows.MoonAnimator.DoCompositeAction("AddToTracks", { Tracks = allTracks, default = true })

	class.setEditingCFrame(selectingTrack)
	local prevCFrame = target.CFrame

	moon.Input:DoAction("Undo")
	if #groupTracks > 0 then
		moon.Input:DoAction("Undo")
	end

	for i = 0, LayerSystem.length do
		local currentCFrame = target.CFrame

		local rotDelta = currentCFrame.Rotation * prevCFrame:Inverse().Rotation
		local posDelta = currentCFrame.Position - prevCFrame.Position

		local cframe = rotDelta + posDelta

		for _, tbl in pairs(EditingTargets) do
			local Track = tbl.Track
			if Track.Target.ClassName == "Motor6D" then
				local motor = Track.Target

				local centerPos = tbl.ini_cf.Position

				local rotationCF = cframe - cframe.Position
				local posOffset = cframe.Position

				local initialRotation = tbl.ini_cf - centerPos
				local newPart1CF = CFrame.new(centerPos + posOffset) * rotationCF * initialRotation

				local jointWorld = motor.Part0.CFrame * motor.C0
				motor.C1 = newPart1CF:Inverse() * jointWorld
			elseif Track.Target.ClassName == "Bone" then
				local transformedWorld = tbl.ini_cf
				local newWorldCF = (cframe + transformedWorld.p) * (transformedWorld - transformedWorld.p)
				local transformOffset = transformedWorld:toObjectSpace(newWorldCF)
				Track.Target.Transform = tbl.ini_transform * transformOffset
			else
				local cf = cframe * tbl.ini_transform.Rotation + tbl.ini_transform.Position
				Track:set_prop(cf)
				Track.value = cf
			end
		end

		class.saveCurrent()
		if mode == "frame" then
			class.nextFrame()
		else
			class.nextPose()
		end
	end
end

local prevFrame
local lastPlaying = PlaybackHandler.Playing
function class.preRender(delta)
	local clampFrame = math.clamp(math.floor(LayerSystem.SliderFrame), 0, LayerSystem.length)
	if prevFrame ~= clampFrame then
		if not motionGraph.creatingMotionGraph then
			motionGraph.updateMotionGraph(clampFrame)
		end
	end
	if lastPlaying ~= PlaybackHandler.Playing then
		motionGraph.updateMotionGraph()
	end
	lastPlaying = PlaybackHandler.Playing
	prevFrame = LayerSystem.SliderFrame
end

return class
]]></ProtectedString>
					<string name="ScriptGuid">{B8CE1B2F-09DC-4CBC-A24F-C8F71DF05745}</string>
