<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Folder" referent="RBX4BF698FF80E34B1D8B1E1C1162606C2F">
		<Properties>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">PhobosRotationPlus</string>
			<int64 name="SourceAssetId">-1</int64>
			<BinaryString name="Tags"></BinaryString>
		</Properties>
		<Item class="ModuleScript" referent="RBX4F06A9DA64044AF48311BAB825487421">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local Janitor = require("./Utils/Janitor")
local charm = require("./Utils/charm")
local class = {}

local mouse: Mouse
local mth = require("./Utils/Math")
local moonHelper = require("./Utils/MoonHelper")
local ikManager = require("./Utils/IKManager")
local motionGraph = require("./Helper/MotionGraph")
local config = require("./Config")
local pin = require("./Helper/Pin")
local data = require("./Utils/Data")
local inheriteRotation = require("./Helper/InheriteRotation")

local stateicons = {
	idle = "rbxasset://SystemCursors/Arrow",
	move = "rbxasset://SystemCursors/ClosedHand",
	ball_rotate = "rbxasset://SystemCursors/SizeAll",
}

class.state = charm.atom("idle")
class.startMousePos = charm.atom(Vector2.zero)
class.currentMousePos = charm.atom(Vector2.zero)
class.startMouseDegree = charm.atom(0)

local prevMousePos

class.FixDirection = charm.atom(nil) :: charm.Atom<nil> | charm.Atom<string>
class.isNotFixDirection = charm.atom(false)

local screenUI = CoreGui:FindFirstChild("PhobosRotation")
local rotateLine
local uiCleaner = Janitor.new()
local partCleaner = Janitor.new()

local function createPart(position, size, color)
	local part = Instance.new("Part")
	part.Parent = workspace.CurrentCamera
	part.Position = position
	part.Size = size + Vector3.one * 0.025
	part.Color = color

	part.Material = Enum.Material.Neon

	partCleaner:Add(part)
end

local function createDirectionLine(direction)
	local center = moonHelper.getCenterPosition()

	for _, axis in ipairs(direction) do
		if axis == "X" then
			createPart(center, Vector3.xAxis * 2048, Color3.new(1, 0, 0))
		elseif axis == "Y" then
			createPart(center, Vector3.yAxis * 2048, Color3.new(0, 0, 1))
		elseif axis == "Z" then
			createPart(center, Vector3.zAxis * 2048, Color3.new(0, 1, 0))
		end
	end
end

local function getAllowDirection()
	local AllowDirction = { "X", "Y", "Z" }
	if class.FixDirection() then
		if class.isNotFixDirection() then
			table.remove(AllowDirction, table.find(AllowDirction, class.FixDirection()))
		else
			AllowDirction = { class.FixDirection() }
		end
	end

	return AllowDirction
end


local function updatePreview()
	local currentPos = if class.state() == "rotate" then Vector2.new(mouse.X, mouse.Y) else class.currentMousePos() 
	
	local sentivity = if class.state() == "move" then config.data.move_sensitivity.value else config.data.rotate_sensitivity.value
	
	local mouseData = {
		startPos = class.startMousePos(),
		currentPos = currentPos,
		startDegree = class.startMouseDegree(),
		currentDegree = mth.degreeAroundCenter(moonHelper.getCenterPosition(), currentPos),
		sensitivity = sentivity * (#data.getSetting("cookie") or 1000) / 64 * 0.05,
		direction = getAllowDirection(),
	}
	local rotated_Cframe = mth.mouseToCframe(mouseData, class.state())
	moonHelper.previewKeyFrame(rotated_Cframe)
	inheriteRotation.update()
	ikManager.moveBonesToIk()
	
	if moonHelper.isPlaying() and config.data.enable_live_keyframing.value then --! Ik may not work
		moonHelper.saveCurrent()
		moonHelper.nextFrame()
		moonHelper.play()
	end
end

local function iconUpdate(radian)
	mouse.Icon = mth.radianToResizeCursor(radian)
end

local function updateLine(mousePos)
	local thickness = 5
	local lineData = mth.getLine(mth.worldToScreenPoint(moonHelper.getCenterPosition()), mousePos, thickness)
	rotateLine.Size = lineData.Size
	rotateLine.Position = lineData.Position
	rotateLine.Rotation = lineData.Rotation
	rotateLine.TileSize = UDim2.fromOffset(thickness * 1.75, thickness)
end

charm.effect(function()
	if class.state() ~= "idle" then
		local direction = getAllowDirection()

		partCleaner:Cleanup()
		if #direction == 3 then
			return
		end
		if class.state() == "ball_rotate" then
			return
		end

		createDirectionLine(direction)

		updatePreview()
	end
end)

local function returnToDefaultState()
	moonHelper.focus()
	moonHelper.saveCurrent()
	partCleaner:Cleanup()
	
	class.FixDirection(nil)
	class.isNotFixDirection(false)
end

charm.subscribe(class.state, function(state, prev)
	local mousePos = Vector2.new(mouse.X, mouse.Y)
	uiCleaner:Cleanup()

	if prev == "idle" then
		moonHelper.setEditingCFrame()
		inheriteRotation.setEditingCFrame()
		ikManager.initIk()

		class.startMousePos(mousePos)
		class.currentMousePos(mousePos)
		prevMousePos = mousePos
		class.startMouseDegree(mth.degreeAroundCenter(moonHelper.getCenterPosition(), mousePos))
		moonHelper.unFocus()
	end

	if state == "rotate" then
		if config.data.rotation_tool_guide_line.value then
			rotateLine = Instance.new("ImageLabel")
			rotateLine.Image = "rbxassetid://14657415531"
			rotateLine.BackgroundTransparency = 1
			-- rotateLine.BackgroundColor3 = Color3.new(0, 0, 0)
			rotateLine.Parent = screenUI
			rotateLine.AnchorPoint = Vector2.new(0.5, 0.5)
			rotateLine.ScaleType = Enum.ScaleType.Tile
			uiCleaner:Add(rotateLine)
			updateLine(mousePos)
		end
	end

	if stateicons[state] then
		mouse.Icon = stateicons[state]
	end

	if state == "idle" then
		returnToDefaultState()
	else
		updatePreview()
		motionGraph.graphCleanup()
		motionGraph.trackDirty = true
	end
end)

charm.subscribe(class.currentMousePos, function(currentPos, prevpos)
	local offset = currentPos - class.startMousePos()

	if offset.Magnitude > 0 then
		updatePreview()
	end
end)

function class.apply()
	class.state("idle")
end

function class.reset()
	if class.state() ~= "idle" then
		class.currentMousePos(class.startMousePos())
		updatePreview()
		class.state("idle")
	end
end

function class.update(delta)
	if class.state() == "idle" then
		return
	end
	
	if not prevMousePos then
		return
	end
	
	local deltaX = mouse.X - prevMousePos.X
	local deltaY = mouse.Y - prevMousePos.Y

	class.currentMousePos(class.currentMousePos() + Vector2.new(deltaX, deltaY) * 
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then 1 else 20
	)
	if rotateLine then
		updateLine(Vector2.new(mouse.X, mouse.Y))
	end
	if class.state() == "rotate" then
		iconUpdate(mth.degreeAroundCenter(moonHelper.getCenterPosition(), class.currentMousePos()))
	end
	
	prevMousePos = Vector2.new(mouse.X, mouse.Y)
end

class.actions = {
	["Toggle Motion Graphs"] = function()
		config.data.motion_graph_enable:set(
			not config.data.motion_graph_enable.value
		)
	end,

	["Previous Pin"] = function()
		pin.prev()
	end,

	["Next Pin"] = function()
		pin.next()
	end,
	
	["Inherite Rotation Part"] = function()
		moonHelper.iterateTrack(function(track)
			inheriteRotation.addOrRemoveTrack(track)
		end)
	end,
	
	["Hide Gui"] = function()
		moonHelper.hideUI = not moonHelper.hideUI
	end,
	
	["Reset Position"] = function()
		local saves = {}
		moonHelper.iterateTrack(function(track)
			table.insert(saves, moonHelper.getInitialData(track))
			local default: CFrame = track.defaultValue
			local motor: Motor6D = track.Target
			
			motor.C1 = motor.C1.Rotation + default.Position
		end)
		moonHelper.saveCurrent(saves)
	end,
	
	["Reset Rotation"] = function()
		local saves = {}
		moonHelper.iterateTrack(function(track)
			local tbl = moonHelper.getInitialData(track)
			
			table.insert(saves, tbl)
			
			local pivotCFrame = track.Target.Part0.CFrame * track.Target.C0
			local pivotPosition = (tbl.ini_cf * track.defaultValue).p
			local delta = pivotPosition - pivotCFrame.p
			pivotCFrame = pivotCFrame + delta

			local relativeToPivot = pivotCFrame:toObjectSpace(tbl.ini_cf)
			local newPartCFrame = ((track.defaultValue.Rotation * track.Target.Part1.CFrame.Rotation:Inverse()) 
				* (pivotCFrame - pivotCFrame.p) + pivotCFrame.p):toWorldSpace(relativeToPivot)

			track.Target.C1 = newPartCFrame:Inverse() * (pivotCFrame - delta)
		end)
		moonHelper.saveCurrent(saves)
	end,
}


function class.init()
	pin.init()
	ikManager.init()
end


function class.setMouse(m)
	mouse = m
end


return class
]]></ProtectedString>
				<string name="ScriptGuid">{36AF4512-17EA-441F-B592-3AD3D82D0C3C}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Controller</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBXC613A7E6471946CC84F513527D31E68D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local data = require("./Utils/Data")
data.getSetting = function(key)
	return plugin:GetSetting(key)
end
data.setSetting = function(key, value)
	return plugin:SetSetting(key, value)
end

for i=1, 99 do
	data["get"..tostring(i)] = function(key)
		return
	end
end

local license = require("./License")
license._0xEn()

local screenUI = CoreGui:FindFirstChild("PhobosRotation")
if not screenUI then
	screenUI = Instance.new("ScreenGui")
	screenUI.Parent = CoreGui
	screenUI.Name = "PhobosRotation"
end
for _, i in screenUI:GetChildren() do
	i:Destroy()
end

local moon = _G.MoonGlobal
local attempts = 0
repeat
	moon = _G.MoonGlobal
	attempts += 1

	if attempts > 60 then
		warn("No found Moon")

		_G.MoonGlobal = {}
		moon = _G.MoonGlobal
		break
	end
	task.wait(0.1)
until moon
repeat
	task.wait()
until moon.ready

local controller = require("./Controller")
local moonHelper = require("./Utils/MoonHelper")
local config = require("./Config")
local pin = require("./Helper/Pin")
local hash = require("./Utils/Hash")

local mouse = plugin:GetMouse()

controller.init()
controller.setMouse(mouse)
moonHelper.setActivate(function(t)
	plugin:Activate(t)
end)
plugin:Activate(true)

local userId = game:GetService("StudioService"):GetUserId()
local hashID = hash(tostring(userId))

local Ui = require("./UI.story")

Ui.iris.Init(screenUI)
Ui.story()


local function getModifierState()
	return {
		SHIFT = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift),
		CTRL  = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl),
		ALT   = UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) or UserInputService:IsKeyDown(Enum.KeyCode.RightAlt),
	}
end

local function parseKeybind(bind)
	local parts = string.split(bind, "_")
	local mainKey = parts[#parts]

	local required = {
		SHIFT = false,
		CTRL  = false,
		ALT   = false,
	}

	for i = 1, #parts - 1 do
		if required[parts[i]] ~= nil then
			required[parts[i]] = true
		end
	end

	return mainKey, required
end

local function keybindMatches(inputKey, bind)
	local mainKey, required = parseKeybind(bind)
	if inputKey ~= mainKey then
		return false
	end

	local state = getModifierState()
	for mod, needed in pairs(required) do
		if state[mod] ~= needed then
			return false
		end
	end

	return true
end

UserInputService.InputBegan:Connect(function(input: InputObject, gs)
	if data.getSetting("cookie") ~= hashID then
		return
	end
	
	if gs and input.UserInputType == Enum.UserInputType.Keyboard then return end

		
	if RunService:IsRunning() then
		return
	end
	
	if not moonHelper.allAvailable() then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		controller.apply()
		return
	end
	
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		controller.reset()
		return
	end
	
	local keyName = input.KeyCode.Name
	for actionName, bindData in pairs(config.keybind) do
		if not bindData.value  then
			continue
		end
		
		if keybindMatches(keyName, bindData.value) then
			local action = controller.actions[actionName]
			if action then
				action()
			end
			break
		end
	end


	if not moonHelper.trackAvailable() and not moonHelper.moonUiUnfocus then
		return
	end

	if input.KeyCode == Enum.KeyCode.X or input.KeyCode == Enum.KeyCode.Y or input.KeyCode == Enum.KeyCode.Z then
		if controller.state() ~= "idle" then
			controller.FixDirection(input.KeyCode.Name)
			controller.isNotFixDirection(UserInputService:IsKeyDown(Enum.KeyCode.Tab))
		end
	end

	if input.KeyCode.Name == config.keybind.Rotate.value then
		if controller.state() == "rotate" then
			controller.state("ball_rotate")
		else
			controller.state("rotate")
		end
	elseif input.KeyCode.Name == config.keybind["Grab Tool"].value then
		controller.state("move")
	end
end)

RunService.PreRender:Connect(function(delta)
	controller.update(delta)
	moonHelper.preRender(delta)
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{E7D6EBB2-8280-49AC-BB96-EF53D27D5386}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Main</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX76E36FFC9A6441BEABF68864BABBA5B5">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[local Selection = game:GetService("Selection")
local UserInputService = game:GetService("UserInputService")

local Iris = require("./Utils/Iris")

local ikManager = require("./Utils/IKManager")
local moonHelper = require("./Utils/MoonHelper")
local config = require("./Config")
local hash = require("./Utils/Hash")
local dataUtils = require("./Utils/Data")
local motionGraph = require("./Helper/MotionGraph")
local inheriteRotation = require("./Helper/InheriteRotation")

local lastInput: InputObject?
UserInputService.InputBegan:Connect(function(a0: InputObject, a1: boolean)
	lastInput = a0
end)

local userId = game:GetService("StudioService"):GetUserId()
local hashID = hash(tostring(userId))

local license = require("./License")

local selected
Selection.SelectionChanged:Connect(function()
	local selecting = Selection:Get()[1]
	if selecting then
		selected = selecting
	end
end)

local keybinds = {
	"Grab Tool",
	"Rotate",
	"Toggle Motion Graphs",
	"Previous Pin",
	"Next Pin",
	"Inherite Rotation Part",
	"Hide Gui",
	"Reset Position",
	"Reset Rotation"
}

moonHelper.setupDefaultKeys()
for name, data in moonHelper.getActions() do
	if #data.keys > 0 then
		local keys = table.clone(data.keys)
		for idx, key in keys do
			local setting = dataUtils.getSetting(`Moon_{name}_{idx}`)
			if setting then
				keys[idx] = setting
			end
		end
		moonHelper.updateControl(name, keys)
	end	
end

local story = {
	iris = Iris,
	story = function(props)
		Iris:Connect(function()
			local showMainWindow = Iris.State(false)
			
			if not moonHelper.isUiVisible() then
				return
			end

			if showMainWindow.value == false then
				Iris.Checkbox({ if dataUtils.getSetting("cookie") then "Phobos Utility Plus" else "Phobos Utility Plus (Locked)" }, { isChecked = showMainWindow })
				return
			end
			
			Iris.Window({ if dataUtils.getSetting("cookie") then "Phobos Utility Plus" else "Phobos Utility (Locked)" }, { isOpened = showMainWindow })
			do
				if not dataUtils.getSetting("cookie") then
					local applying = Iris.State(false)
					
					Iris.Text("Enter License or Purchase Gamepass to unlock Plus Version")
					Iris.Text("more info on discord")
					local InputText = Iris.InputText("Enter License")
					
					if Iris.Button(if applying.value then "Applying... (Maybe take more than 30 seconds)" else "Apply License").clicked() then
						if not applying.value then
							applying:set(true)
							task.spawn(function()
								license._0xEn(InputText.text.value)
								applying:set(false)
							end)
						end
					end
					
					Iris.End()
					return
				end
				
				Iris.CollapsingHeader({ "Settings" })
				do
					Iris.DragNum({ "Move Sensitivity", 0.1, 0, 100 }, { number = config.data.move_sensitivity })
					Iris.DragNum({ "Rotate Sensitivity", 0.1, 0, 100 }, { number = config.data.rotate_sensitivity })
					Iris.Checkbox(
						{ "Grab tool sensitivity scale with distance" },
						{ isChecked = config.data.move_change_sensitive }
					)
					Iris.Checkbox(
						{ "Hide Moon Gui When Using Tool" },
						{ isChecked = config.data.hide_moon_when_tool }
					)
					Iris.Checkbox(
						{ "Rotate Tool Guide Line" },
						{ isChecked = config.data.rotation_tool_guide_line }
					)
					Iris.Checkbox(
						{ "Enable Live Keyframing" },
						{ isChecked = config.data.enable_live_keyframing }
					)
				end
				Iris.End()

				Iris.CollapsingHeader({ "Keybinds" })
				do					
					local keys = {}
					for name, data in moonHelper.getActions() do
						for _, key in data.keys do
							keys[name] = key
						end
					end
					
					for idx, name in keybinds do
						local key = config.keybind[name]
						if not key then
							continue
						end
						
						local isChanging = Iris.State(false)

						if lastInput and lastInput.KeyCode ~= Enum.KeyCode.LeftShift and 
							lastInput.KeyCode ~= Enum.KeyCode.LeftControl and lastInput.KeyCode ~= Enum.KeyCode.LeftAlt then
							
							if isChanging.value then
								if lastInput.UserInputType == Enum.UserInputType.Keyboard then
									if lastInput.KeyCode == Enum.KeyCode.Escape then
										key:set(nil)
									else
										local finalKey = ""
										if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
											finalKey ..= "SHIFT_"
										end
										if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
											finalKey ..= "CTRL_"
										end
										if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then
											finalKey ..= "ALT_"
										end
										key:set(finalKey..lastInput.KeyCode.Name)
									end
									isChanging:set(false)
								end

								lastInput = nil
							end
						end
						local moonOverride
						for keyName, bind in keys do
							if bind == key.value  then
								moonOverride = keyName
								break
							end 
						end
						local warnText = if moonOverride then ` (same with moon '{moonOverride}')` else ""
						
						local keybind = key.value or "Not Bind"
						if key.value then
							keybind ..= warnText
						end
						
						Iris.SameLine()
						do
							Iris.Text(name..":")
							if
								Iris.Button({ `{if isChanging.value then "Press Keybind" else keybind}` })
								.clicked()
							then
								isChanging:set(true)
							end
						end
						Iris.End()
					end
					Iris.Separator()
				end
				Iris.End()
				
				Iris.CollapsingHeader({ "Moon Animtor Keybinds" })
				do					
					Iris.Text("Reset To Default Moon Animator Keybinds")
					if Iris.Button( {"Reset"} ).clicked() then
						for name, keys in moonHelper.getDefaultKeys() do
							moonHelper.updateControl(name, table.clone(keys))
							for idx, key in keys do
								dataUtils.setSetting(`Moon_{name}_{idx}`, key)
							end
						end
					end
					Iris.Text("")
					
					Iris.Separator()
					for name, data in moonHelper.getActions() do
						if #data.keys > 0 then
							Iris.Text(name)
							local keys = table.clone(data.keys)
							for idx, key in keys do
								local isChanging = Iris.State(false)
								
								local text = if key:match("*") then key.." (might break if changed)" else key
								
								if Iris.Button({ if isChanging.value then "Press Keybind" else text }).clicked() then
									isChanging:set(true)
								end
								
								if isChanging.value and lastInput and lastInput.KeyCode ~= Enum.KeyCode.LeftShift and 
									lastInput.KeyCode ~= Enum.KeyCode.LeftControl and lastInput.KeyCode ~= Enum.KeyCode.LeftAlt then
									if lastInput.UserInputType == Enum.UserInputType.Keyboard then
										if lastInput.KeyCode == Enum.KeyCode.Escape then
											keys[idx] = "Not Bind"
										else
											local finalKey = ""
											if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
												finalKey ..= "SHIFT_"
											end
											if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
												finalKey ..= "CTRL_"
											end
											if UserInputService:IsKeyDown(Enum.KeyCode.LeftAlt) then
												finalKey ..= "ALT_"
											end
											keys[idx] = finalKey..lastInput.KeyCode.Name
										end
										isChanging:set(false)
										moonHelper.updateControl(name, keys)
										dataUtils.setSetting(`Moon_{name}_{idx}`, keys[idx])
									end
									lastInput = nil
								end
							end
							Iris.Separator()
						end
					end
				end
				Iris.End()

				Iris.CollapsingHeader({ "Keyframe Utility" })
				do
					Iris.Text({ "CFrame to Keyframe" })

					local tracks = "["
					moonHelper.iterateTrack(function(track)
						tracks ..= `{track.name},`
					end)
					tracks = tracks:sub(0, -2)
					tracks ..= "]"

					if Iris.Button({ "Copy" }).clicked() then
						if #tracks > 1 and selected then
							moonHelper.cframe2keyframe(selected, "frame")
						else
							warn("No track or instance selected")
						end
					end

					Iris.Text({ `Track: {if #tracks > 1 then tostring(tracks) else "No Selection"}` })
					Iris.Text({ `Instance: {if selected then selected.Name else "No Selection"}` })

					-- if Iris.Button({ "Track Debug" }).clicked() then
					-- 	if selected then
					-- 		moonHelper.checkDefaultCFrame(selected)
					-- 	end
					-- end
				end
				Iris.End()

				Iris.CollapsingHeader({ "Motion Graph" })
				do
					Iris.Checkbox({ "Enable" }, { isChecked = config.data.motion_graph_enable })

					if config.data.motion_graph_enable.value then
						Iris.SeparatorText("Setting")
						
						Iris.SeparatorText("Visual")
						local past = Iris.State(Color3.new(dataUtils.getSetting("pcr") or 1, dataUtils.getSetting("pcg") or 0, dataUtils.getSetting("pcb") or 0))
						local future = Iris.State(Color3.new(dataUtils.getSetting("fcr") or 0, dataUtils.getSetting("fcg") or 1, dataUtils.getSetting("fcb") or 0))
						local size = config.data.point_size
						
						Iris.InputColor3({ "Previous Color" }, { color = past })
						Iris.InputColor3({ "Next Color" }, { color = future })
						Iris.DragNum({ "Keyframe Point Size", 0.01, 0, 10 }, { number = size })
						if past:changed() then
							dataUtils.setSetting("pcr", past.value.R)
							dataUtils.setSetting("pcg", past.value.G)
							dataUtils.setSetting("pcb", past.value.B)
							motionGraph.setPastColor(past.value)
						end
						if future:changed() then
							dataUtils.setSetting("fcr", future.value.R)
							dataUtils.setSetting("fcg", future.value.G)
							dataUtils.setSetting("fcb", future.value.B)
							motionGraph.setFutureColor(future.value)
						end
						if size:changed() then
							motionGraph.setCubeSize(size.value)
						end
						
						Iris.SeparatorText("Output")
						
						Iris.ComboArray({ "Curve Mode" }, { index = config.data.curve_mode }, { "Frame", "Pose" })
						Iris.Checkbox({ "Visualize On Pivot Point" }, { isChecked = config.data.pivot_point })
						Iris.Checkbox({ "Show Only Nearby" }, { isChecked = config.data.show_only_nearby })
						Iris.DragNum({ "Nearby Range", 1, 1, math.huge }, { number = config.data.nearby_range })
						--Iris.Checkbox(
						--	{ "Disable On Playing" },
						--	{ isChecked = config.data.motion_graph_disable_on_playing }
						--)
					end
				end
				Iris.End()

				Iris.CollapsingHeader({ "Inverse Kinematic (BETA)" })
				do
					Iris.Text({ "basically just kinematics, but inverse" })
					local tracks = "["
					local first = true
					local target
					moonHelper.iterateTrack(function(track)
						if first then
							first = false
							target = track
							return
						end
						tracks ..= `{track.name},`
					end)
					tracks = tracks:sub(0, -2)
					tracks ..= "]"
					Iris.Text({ `Track: {if #tracks > 1 then tostring(tracks) else "No Selection"}` })
					Iris.Text({ `Target: {if target then target.name else "No Selection"}` })

					if Iris.Button({ "Create IK" }).clicked() then
						ikManager.createIk(selected)
					end
					--if Iris.Button({ "Debug Test" }).clicked() then
					--	ikManager.moveBonesToIk()
					--end
					--if Iris.Button({ "Save" }).clicked() then
					--	ikManager.saveControllers()
					--end
					--if Iris.Button({ "Load" }).clicked() then
					--	ikManager.loadIK(moonHelper.getAllTracks())
					--end

					for _, object in ikManager.IKObjects do
						Iris.Tree({ object.name })
						do
							Iris.Separator()
							
							local tracks = moonHelper.getSelectedTracks()
							Iris.Text( { `Selecting: {if tracks[1] then tracks[1].name else "No Selection"}` } )
							Iris.SameLine()
							do
								Iris.Text(if object.target then `Target: {object.target.Target.name}` else "Target: Missing")
								if Iris.Button({ "Change" }).clicked() then
									if tracks[1] then
										object.target = tracks[1]
										ikManager.saveOrUpdate(object)
									end
								end
							end
							Iris.End()
							Iris.SameLine()
							do
								Iris.Text(if object.pole then `Pole: {object.pole.Target.name}` else "Pole: None")
								if Iris.Button({ "Change" }).clicked() then
									if tracks[1] then
										object.pole = tracks[1]
										ikManager.saveOrUpdate(object)
									end
								end
							end
							Iris.End()
							Iris.Separator()
							local enteredText = Iris.InputText({ "", "New Name" })
							if Iris.Button({ "Rename" }).clicked() then
								if #enteredText.text.value > 0 then
									ikManager.rename(object.name, enteredText.text.value)
								end
							end
							Iris.Separator()
							for _, track in object.tracks do
								Iris.Tree({ track.Path:GetItem().Name })
								do
									local constraint = if object.controller.Constraints then
										object.controller.Constraints[track.Target] else nil
										
									local enable = Iris.State(constraint ~= nil)
									local upperAngle = Iris.State(if constraint then constraint.UpperAngle else 180)
									local lowerAngle = Iris.State(if constraint then constraint.LowerAngle else -180)
									local check = Iris.Checkbox( {"Enable"} , {isChecked = enable})
									
									if check.checked() then
										ikManager.setConstraints(object, track.Target, upperAngle.value, lowerAngle.value)
										ikManager.saveOrUpdate(object)
									elseif check.unchecked() then
										ikManager.removeConstraints(object, track.Target)
									end
									
									Iris.InputNum( {"UpperAngleLimit"} , {number = upperAngle})
									Iris.InputNum( {"LowerAngleLimit"} , {number = lowerAngle})
		
									if (upperAngle:changed() or lowerAngle:changed()) and enable.value then
										ikManager.setConstraints(object, track.Target, upperAngle.value, lowerAngle.value)
										ikManager.saveOrUpdate(object)
									end
								end
								Iris.End()
							end
						end
						Iris.End()
					end
				end
				Iris.End()
				
				--Iris.CollapsingHeader({ "Testing" })
				--do
				--	if Iris.Button({ "Inherite Rotation" }).clicked() then
				--		moonHelper.iterateTrack(function(track)
				--			inheriteRotation.addTrack(track)
				--		end)
				--	end
				--end
				--Iris.End()
			end
			Iris.End()
		end)
	end,
}

return story
]]></ProtectedString>
