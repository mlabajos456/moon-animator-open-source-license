				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local class = {}

local moon = _G.MoonGlobal

local LayerSystem = moon.Windows.MoonAnimator.g_e.LayerSystem
local LayerHandler = LayerSystem.LayerHandler
local PlaybackHandler = LayerSystem.PlaybackHandler
local SelectionHandler = LayerSystem.SelectionHandler

local camera = workspace.CurrentCamera
local config = require("../Config")
local Janitor = require("../Utils/Janitor")
local ObjectPool = require("../Utils/ObjectPool")
local dataUtils = require("../Utils/Data")

local graphs = camera:FindFirstChild("Phobos Motion Graphs") or Instance.new("Folder")
graphs.Parent = camera
graphs.Name = "Phobos Motion Graphs"

for _, i in graphs:GetChildren() do
	i:Destroy()
end

local LineFrame = Instance.new("WireframeHandleAdornment")
LineFrame.Adornee = workspace.Terrain
LineFrame.Parent = graphs
LineFrame.AlwaysOnTop = true
LineFrame.Color3 = Color3.new(dataUtils.getSetting("pcr") or 1, dataUtils.getSetting("pcg") or 0, dataUtils.getSetting("pcb") or 0)
LineFrame.Thickness = 5
LineFrame.ZIndex = 0

local FutureFrame = Instance.new("WireframeHandleAdornment")
FutureFrame.Adornee = workspace.Terrain
FutureFrame.Parent = graphs
FutureFrame.AlwaysOnTop = true
FutureFrame.Color3 = Color3.new(dataUtils.getSetting("fcr") or 0, dataUtils.getSetting("fcg") or 1, dataUtils.getSetting("fcb") or 0)
FutureFrame.Thickness = 5
FutureFrame.ZIndex = 0

local boxSize = config.data.point_size.value

function class.setPastColor(color)
	LineFrame.Color3 = color
	class.updateMotionGraph()
end

function class.setFutureColor(color)
	FutureFrame.Color3 = color
	class.updateMotionGraph()
end

function class.setCubeSize(size)
	boxSize = size
	for _, i in graphs:GetChildren() do
		if i:IsA("BoxHandleAdornment") then
			i.Size = Vector3.new(boxSize/100,boxSize/100,boxSize/100)
		end
	end
end

local graphsCleaner = Janitor.new()
function class.graphCleanup()
	LineFrame:Clear()
	FutureFrame:Clear()
	graphsCleaner:Cleanup()
end

local function createPointingPart(vec1, vec2, future)
	if future then
		FutureFrame:AddLine(vec1, vec2)
	else
		LineFrame:AddLine(vec1, vec2)
	end
end

local function positionDebug(vec)
	if not vec then return end

	local box = Instance.new("BoxHandleAdornment")
	box.Adornee = workspace.Terrain
	box.CFrame = CFrame.new(vec)
	box.Size = Vector3.new(boxSize/100,boxSize/100,boxSize/100)
	box.Color3 = Color3.new(0, 0, 0)
	box.AlwaysOnTop = true
	box.ZIndex = 1
	box.Parent = graphs

	graphsCleaner:Add(box)
end

local function frameBox(vec)
	if not vec then return end

	local box = Instance.new("BoxHandleAdornment")
	box.Adornee = workspace.Terrain
	box.CFrame = CFrame.new(vec)
	box.Size = Vector3.new(0.1,0.1,0.1)
	box.Color3 = Color3.new(1, 1, 1)
	box.AlwaysOnTop = true
	box.ZIndex = 1
	box.Parent = graphs

	graphsCleaner:Add(box)
end


local function setPoseOnFrame(tracks ,frame)
	local LastTracks = {}
	for _, Track in pairs(tracks) do
		if Track.UpdateLast then
			table.insert(LastTracks, Track)
		else
			Track:_Update(frame)
		end
	end
	for _, Track in pairs(LastTracks) do
		Track:_Update(frame)
	end
end


local prevPos = {}
local function createMotionGraph(frame, tracks, future)
	local rigs = {}
	for id, rig in LayerHandler.ItemMap do
		for path, track in rig.RigMap do
			if table.find(tracks, track) then
				rigs[rig.Path:GetItem().Name] = true
			end
		end
	end
	local updatePoseTracks = {}
	for id, rig in LayerHandler.ItemMap do
		if rigs[rig.Path:GetItem().Name] then
			for path, track in rig.RigMap do
				table.insert(updatePoseTracks, track)
			end
		end
	end
	
	--LayerSystem:SetSliderFrame(frame)
	setPoseOnFrame(updatePoseTracks, frame)
	
	for i, track in tracks do
		local target = track.Target
		local pos
		if config.data.pivot_point.value then
			if moon.objIsType(track, "MotorTrack") then
				pos = (target.Part1.CFrame * track.defaultValue).Position
			elseif moon.objIsType(track, "BoneTrack") then
				pos = track.Target.TransformedWorldCFrame.p
			elseif track.part then
				pos = track.part.CFrame.p
			end
		else
			if moon.objIsType(track, "MotorTrack") then
				pos = track.Target.Part1.CFrame.p
			elseif moon.objIsType(track, "BoneTrack") then
				pos = track.Target.TransformedWorldCFrame.p
			elseif track.part then
				pos = track.part.CFrame.p
			end
		end

		if not pos then
			return
		end

		if prevPos[i] then
			createPointingPart(prevPos[i], pos, future)
		end
		
		local positions = {}
		for pos, _ in track.TrackItemPositions do
			table.insert(positions, pos)
		end
		
		if frame == LayerSystem.SliderFrame and config.data.show_only_nearby.value then
			frameBox(pos)
		end

		
		if table.find(positions, frame) then
			positionDebug(pos)
		end
		prevPos[i] = pos
	end
end

class.creatingMotionGraph = false
class.trackDirty = true
-- class.posDirty = true
-- class.slideDirty = true
function class.updateMotionGraph()
	if not config.data.motion_graph_enable.value then
		class.graphCleanup()
		return
	end

	--if config.data.motion_graph_disable_on_playing.value then
	--	if PlaybackHandler.Playing then
	--		for _, i in graphCache do
	--			i.Transparency = 1
	--		end
	--		return
	--	else
	--		for _, i in graphCache do
	--			i.Transparency = 0
	--		end
	--	end
	--end

	if not class.trackDirty then
		if not config.data.show_only_nearby.value then
			return
		end
	else
		class.trackDirty = false
	end
	class.graphCleanup()

	-- if class.posDirty then
	-- 	class.posDirty = false
	-- 	class.graphCleanup()
	-- end

	if not LayerHandler.ActiveItemObject then
		return
	end

	debug.profilebegin("Motion Graphs")
	local currentFrame = LayerSystem.SliderFrame
	local KeyframeTracks = {}
	SelectionHandler.SelectedTracks:Iterate(function(KeyframeTrack)
		table.insert(KeyframeTracks, KeyframeTrack)
	end)
	
	if #KeyframeTracks == 0 then
		return
	end
	
	table.clear(prevPos)
	class.creatingMotionGraph = true

	local PoseMap = LayerHandler.ActiveItemObject.PoseMap

	local positions = {}
	for pos, _ in PoseMap do
		table.insert(positions, pos)
	end
	table.sort(positions)

	local limit = config.data.nearby_range.value
	if config.data.show_only_nearby.value and limit and currentFrame then
		local currentIndex = nil
		for i, pos in ipairs(positions) do
			if pos >= currentFrame then
				currentIndex = i
				break
			end
		end
		currentIndex = currentIndex or #positions

		local startIdx = math.max(1, currentIndex - limit)
		local endIdx = math.min(#positions, currentIndex + limit)

		if config.data.curve_mode.value == "Frame" then
			if not positions[startIdx] or not positions[endIdx] then
				return
			end

			for pos = positions[startIdx], positions[endIdx] do
				createMotionGraph(pos, KeyframeTracks, currentFrame < pos)
			end
		elseif config.data.curve_mode.value == "Pose" then
			for i = startIdx, endIdx do
				createMotionGraph(positions[i], KeyframeTracks, currentFrame < i)
			end
		end
	else
		if config.data.curve_mode.value == "Frame" then
			for pos = 0, LayerSystem.length do
				createMotionGraph(pos, KeyframeTracks)
			end
		elseif config.data.curve_mode.value == "Pose" then
			for _, pos in positions do
				createMotionGraph(pos, KeyframeTracks)
			end
		end
	end

	local updatePoseTracks = {}
	for id, rig in LayerHandler.ItemMap do
		for path, track in rig.RigMap do
			table.insert(updatePoseTracks, track)
		end
	end
	setPoseOnFrame(updatePoseTracks, currentFrame)
	class.creatingMotionGraph = false
	
	debug.profileend()
end

return class
