					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local class = {}

local moonHelper = require("../Utils/MoonHelper")
local moon = _G.MoonGlobal

local LayerSystem = moon.Windows.MoonAnimator.g_e.LayerSystem

class.pinTracks = {}

local function createButton(track)
	if not track.name then
		return
	end
	
	local button = Instance.new("ImageButton"); button.Parent = track.ListComponent
	local pinned = false

	button.MouseButton1Down:Connect(function()
		pinned = not pinned
		if pinned then
			button.Image = "rbxassetid://95773848264212"
			table.insert(class.pinTracks, track)
		else
			button.Image = "rbxassetid://100766907177984"
			local index = table.find(class.pinTracks, track)
			if index then
				table.remove(class.pinTracks, index)
			end
		end
	end)
	button.Size = UDim2.fromOffset(21,21)
	button.Position = UDim2.new(1, -58, 0, 0)
	button.Name = "Pin"
	button.ZIndex = 5
	button.Image = "rbxassetid://100766907177984"
	button.BackgroundTransparency = 1

	track:AddPaintedItem(button, {ImageColor3 = "second"})
end

function class.next()
	local frames = {}
	for k = #class.pinTracks, 1, -1 do
		local track = class.pinTracks[k]
		if rawget(track, "destroyed") then
			table.remove(class.pinTracks, k)
		end
	end

	for k, track in class.pinTracks do
		for pos, i in track.TrackItemPositions do
			table.insert(frames, pos)
		end
	end
	
	local find = LayerSystem.length
	for _, pos in frames do
		if pos < find and pos > LayerSystem.SliderFrame then
			find = pos
		end
	end
	

	if table.find(frames, find) then
		LayerSystem:SetSliderFrame(find)
	end
end

function class.prev()
	local frames = {}
	
	for k = #class.pinTracks, 1, -1 do
		local track = class.pinTracks[k]
		if rawget(track, "destroyed") then
			table.remove(class.pinTracks, k)
		end
	end
	
	for k, track in class.pinTracks do
		for pos, i in track.TrackItemPositions do
			table.insert(frames, pos)
		end
	end
	
	local find = 0
	for _, pos in frames do
		if pos > find and pos < LayerSystem.SliderFrame then
			find = pos
		end
	end
	if table.find(frames, find) then
		LayerSystem:SetSliderFrame(find)
	end
end

function class.init()
	for _, track in moonHelper.getAllTracks() do
		for _,i in track.ListComponent:GetChildren() do
			if i.Name == "Pin" then
				i:Destroy()
			end
		end
		createButton(track)
	end
end

moonHelper.registerTrackConnect(function(track)
	createButton(track)
end)

return class]]></ProtectedString>
