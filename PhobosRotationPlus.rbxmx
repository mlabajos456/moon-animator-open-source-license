				<ProtectedString name="Source"><![CDATA[local data = require("./Utils/Data")

return {
	data = {
		move_change_sensitive = data.save("move_change_sensitive", true),
		move_sensitivity = data.save("move_sensitivity", 2),
		rotate_sensitivity = data.save("rotate_sensitivity", 2),
		hide_moon_when_tool = data.save("hide_moon_when_tool", true),
		rotation_tool_guide_line = data.save("rotation_tool_guide_line", true),
		enable_live_keyframing = data.save("enable_live_keyframing", false),

		motion_graph_enable = data.save("motion_graph_enable", false),
		curve_mode = data.save("curve_mode", "Frame"),
		pivot_point = data.save("on_pivot", false),
		show_only_nearby = data.save("show_only_nearby", true),
		nearby_range = data.save("nearby_range", 10),
		motion_graph_disable_on_playing = data.save("motion_graph_disable_on_playing", false),
		
		point_size = data.save("point_size", 5),
	},
	keybind = {
		["Grab Tool"] = data.save("grab_tool", Enum.KeyCode.H.Name),
		["Rotate"] = data.save("rotate", Enum.KeyCode.T.Name),
		["Toggle Motion Graphs"] = data.save("motion_graphs", nil),
		["Previous Pin"] = data.save("prev_pin", nil),
		["Next Pin"] = data.save("next_pin", nil),
		["Inherite Rotation Part"] = data.save("inherite_rotation", "SHIFT_R"),
		["Hide Gui"] = data.save("hide_gui", nil),
		["Reset Position"] = data.save("reset_pos", nil),
		["Reset Rotation"] = data.save("reset_rot", nil),
	},
}
