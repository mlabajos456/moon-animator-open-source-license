		Win.ExportRigs = function(no_sel)
			local sel = {}

			for _, ItemObject in pairs(LayerHandler.LayerContainer.Objects) do
				ItemObject = ItemObject.ItemObject
				local exportFolder = _g.ExportItemObject(ItemObject)
				if exportFolder then
					for _, obj in pairs(exportFolder:GetChildren()) do
						table.insert(sel, obj)
						if ItemObject.RigContainer then
							local rig = ItemObject.Path:GetItem()
							if rig and rig.Parent then
								local anim_saves = rig:FindFirstChild("AnimSaves")
								if anim_saves == nil then
									anim_saves = Instance.new("Model", rig); anim_saves.Name = "AnimSaves"
								end
								if anim_saves:FindFirstChild(obj.Name) then
									anim_saves[obj.Name]:Destroy()
								end
								obj.Parent = anim_saves
							end
						elseif ItemObject.Path:GetItem().ClassName == "Camera" then
							obj.Parent = ItemObject.Path:GetItem()
						end
					end
					exportFolder:Destroy()
				end
			end
			
			if not no_sel then
				game.Selection:Set(sel)
			end
		end
		
		local function round_json_num(value)
			value = tonumber(value) or 0
			local scaled = value * 1000
if scaled >= 0 then
return math.floor(scaled + 0.5) / 1000
end
return math.ceil(scaled - 0.5) / 1000
		end

		local function random_json_label(prefix)
			return prefix.."_"..tostring(math.random(100000, 999999))
		end

		local function get_joint_name(track)
			local name = track and track.name
			if name == nil or name == "" then
				return random_json_label("joint")
			end
			return name:match("([^%.]+)$") or name
		end

		local function append_keyframe_entries(list, track, track_item)
			if track == nil or track_item == nil or type(track_item.TargetValues) ~= "table" then
				return
			end

			local base_cframe = track.defaultValue
			if typeof(base_cframe) ~= "CFrame" and track.get_prop then
				base_cframe = track:get_prop()
			end
			if typeof(base_cframe) ~= "CFrame" then
				return
			end

			for offset, value in pairs(track_item.TargetValues) do
				if typeof(value) == "CFrame" then
					local frame = track_item.frm_pos + (tonumber(offset) or 0)
					local relative = base_cframe:Inverse() * value
					local rx, ry, rz = relative:ToEulerAnglesXYZ()
					local pos = relative.Position
					table.insert(list, {
						joint = get_joint_name(track),
						frame = frame,
						rotation = {
							x = round_json_num(math.deg(rx)),
							y = round_json_num(math.deg(ry)),
							z = round_json_num(math.deg(rz)),
						},
						position = {
							x = round_json_num(pos.X),
							y = round_json_num(pos.Y),
							z = round_json_num(pos.Z),
						},
					})
				end
			end
		end

		local function build_animation_json(mode)
			local keyframes = {}
			local source_item_object = nil
			local target_name = nil

			if mode == "selected" then
                source_item_object = LayerHandler.ActiveItemObject
                if source_item_object == nil or source_item_object.RigMap == nil or next(source_item_object.RigMap) == nil then
                    return nil, "Select an active rig item before exporting selected keyframes."
                end
                target_name = source_item_object.Path and source_item_object.Path.Item and source_item_object.Path.Item.Name or nil
                SelectionHandler.SelectedTrackItems:Iterate(function(track_item)
                    local track = track_item.ParentTrack
                    if track and track.ItemObject == source_item_object and source_item_object.RigMap and source_item_object.RigMap[track.name] == track then
                        append_keyframe_entries(keyframes, track, track_item)
                    end
                end, "Keyframe")
                if #keyframes == 0 then
                    return nil, "No selected keyframes found on active rig."
                end
            else
				source_item_object = LayerHandler.ActiveItemObject
				if source_item_object == nil or source_item_object.RigMap == nil or next(source_item_object.RigMap) == nil then
					return nil, "Select an active rig item before exporting full animation."
				end
				target_name = source_item_object.Path and source_item_object.Path.Item and source_item_object.Path.Item.Name or nil
				for _, track in pairs(source_item_object.RigMap) do
					track.TrackItems:Iterate(function(track_item)
						append_keyframe_entries(keyframes, track, track_item)
					end, "Keyframe")
				end
				if #keyframes == 0 then
					return nil, "Active rig has no keyframes to export."
				end
			end

			table.sort(keyframes, function(a, b)
				if a.frame == b.frame then
					return tostring(a.joint) < tostring(b.joint)
				end
				return a.frame < b.frame
			end)

			local animation_name = target_name
			if animation_name == nil or animation_name == "" then
				animation_name = random_json_label("animation")
			end

			return {
				animation_name = animation_name,
				description = random_json_label("description"),
				total_frames = LayerSystem.length,
				fps = LayerSystem.FPS,
				intensity = 1,
				target_name = target_name,
				keyframes = keyframes,
			}
		end

		local function persist_export_json(json_text)
			local parent = workspace
			local ok_service, server_storage = pcall(function()
				return game:GetService("ServerStorage")
			end)
			if ok_service and server_storage then
				parent = server_storage
			end

			local folder = parent:FindFirstChild("MoonAnimatorExports")
			if folder == nil then
				folder = Instance.new("Folder")
				folder.Name = "MoonAnimatorExports"
				folder.Parent = parent
			end

			local storage = folder:FindFirstChild("MoonAnimatorExportJSON")
			if storage == nil then
				storage = Instance.new("StringValue")
				storage.Name = "MoonAnimatorExportJSON"
				storage.Parent = folder
			end

			storage.Value = json_text
			return storage:GetFullName()
		end

		local function export_animation_json(mode)
			local animation, err = build_animation_json(mode)
			if animation == nil then
				_g.Windows.MsgBox.Popup(Win, {
					Title = "JSON Export",
					Content = err,
				})
				return
			end

			local json_text = game:GetService("HttpService"):JSONEncode(animation)
			local storage_path = "not_saved"
			local ok_store = pcall(function()
				storage_path = persist_export_json(json_text)
			end)

			local ai_window = _g.Windows and _g.Windows.AIFightAnimator
			if ai_window then
				ai_window:Open()
				if ai_window.LoadExportedJSON then
					ai_window.LoadExportedJSON(animation, json_text, mode, storage_path)
				end
			end

			if not ai_window or not ai_window.LoadExportedJSON then
				_g.Windows.MsgBox.Popup(Win, {
					Title = "JSON Export",
					Content = "Exported "..tostring(#animation.keyframes).." keyframes.",
				})
			end

			if not ok_store then
				_g.Windows.MsgBox.Popup(Win, {
					Title = "JSON Export",
					Content = "JSON generated but could not persist StringValue.",
				})
			end
		end
		

		_g.Input:BindAction(Win, "Export", function()
			Win.ExportRigs()
		end, {"KeypadFive", "Five"}, true)

		_g.Input:BindAction(Win, "ExportSelectedJSON", function()
			export_animation_json("selected")
		end, {}, true)
		_g.Input:BindAction(Win, "ExportTimelineJSON", function()
			export_animation_json("all")
		end, {}, true)
