					<ProtectedString name="Source"><![CDATA[local _g = _G.MoonGlobal
------------------------------------------------------------
local HttpService = game:GetService("HttpService")

local SERVER_URL = "http://localhost:8000"

local function trim(value)
if value == nil then return "" end
return tostring(value):gsub("^%s+", ""):gsub("%s+$", "")
end

local function norm(value)
return string.lower(trim(value))
end

local function toNumberOrDefault(value, defaultValue)
local num = tonumber(value)
if num == nil then
return defaultValue
end
return num
end

local function resolveAnimationTable(decoded)
if type(decoded) ~= "table" then
return nil
end
if type(decoded.animation) == "table" then
decoded = decoded.animation
end
if type(decoded.keyframes) == "table" then
return decoded
end
return nil
end

local function decodeAnimationText(rawText)
local text = trim(rawText)
if text == "" then
return nil, "JSON vacio"
end

local candidates = {text}
local fenced = text:match("```json%s*(.-)%s*```") or text:match("```%s*(.-)%s*```")
if fenced and fenced ~= "" then
table.insert(candidates, fenced)
end

local bracketObject = text:match("(%b{})")
if bracketObject and bracketObject ~= text then
table.insert(candidates, bracketObject)
end

for _, candidate in ipairs(candidates) do
local ok, decoded = pcall(function()
return HttpService:JSONDecode(candidate)
end)
if ok then
local animation = resolveAnimationTable(decoded)
if animation then
return animation
end
end
end

return nil, "JSON invalido o sin keyframes"
end

local function encodeAnimationText(animation)
local ok, encoded = pcall(function()
return HttpService:JSONEncode(animation)
end)
if ok then
return encoded
end
return ""
end

local function requestAnimation(prompt, duration, intensity, targetName)
local payload = {
prompt = prompt,
duration = duration,
intensity = intensity,
target_name = targetName,
}

local success, result = pcall(function()
local response = HttpService:RequestAsync({
Url = SERVER_URL.."/generate",
Method = "POST",
Headers = {
["Content-Type"] = "application/json",
},
Body = HttpService:JSONEncode(payload),
})

if not response.Success then
return nil
end
return HttpService:JSONDecode(response.Body)
end)

if success then
return result
end
return nil
end

local function findItemObjectByName(layerSystem, targetName)
if layerSystem == nil then return nil end
local layerHandler = layerSystem.LayerHandler
if layerHandler == nil or layerHandler.LayerContainer == nil then return nil end

local targetNorm = norm(targetName)
if targetNorm == "" then return nil end

for _, container in pairs(layerHandler.LayerContainer.Objects) do
local itemObject = container.ItemObject
if itemObject and itemObject.Path and itemObject.Path.Item then
if norm(itemObject.Path.Item.Name) == targetNorm then
return itemObject
end
end
end

return nil
end

local function findRigTrack(rigMap, jointName)
if rigMap[jointName] then return rigMap[jointName] end
for path, track in pairs(rigMap) do
local lastPart = path:match("([^%.]+)$")
if lastPart == jointName then
return track
end
end
return nil
end

local function collectTargetKeyframes(animation)
if animation == nil or animation.keyframes == nil then
return {}
end

local filtered = {}
for _, kf in pairs(animation.keyframes) do
table.insert(filtered, kf)
end

table.sort(filtered, function(a, b)
return (tonumber(a.frame) or 0) < (tonumber(b.frame) or 0)
end)

return filtered
end

local function validateKeyframeIntegrity(animation)
-- Verifica que todos los keyframes tengan rotation y position completos
if animation == nil or animation.keyframes == nil then
return false
end

for _, kf in pairs(animation.keyframes) do
if type(kf) ~= "table" then return false end
if not kf.joint or not kf.frame then return false end

local rot = kf.rotation
local pos = kf.position

if type(rot) ~= "table" or rot.x == nil or rot.y == nil or rot.z == nil then
return false
end

if type(pos) ~= "table" or pos.x == nil or pos.y == nil or pos.z == nil then
return false
end
end

return true
end

local function buildContents()
local root = Instance.new("Frame")
root.Name = "Contents"
root.Size = UDim2.new(0, 460, 0, 428)
root.BackgroundTransparency = 1

local title = Instance.new("TextLabel")
title.Name = "Title"
title.Size = UDim2.new(1, -20, 0, 24)
title.Position = UDim2.new(0, 10, 0, 8)
title.BackgroundTransparency = 1
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "IA o JSON -> Timeline"
title.TextSize = 20
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.SourceSansBold
title.Parent = root

local targetName = Instance.new("TextBox")
targetName.Name = "TargetName"
targetName.Size = UDim2.new(1, -20, 0, 34)
targetName.Position = UDim2.new(0, 10, 0, 38)
targetName.ClearTextOnFocus = false
targetName.TextXAlignment = Enum.TextXAlignment.Left
targetName.Text = ""
targetName.TextSize = 18
targetName.TextColor3 = Color3.new(1, 1, 1)
targetName.PlaceholderColor3 = Color3.fromRGB(220, 220, 220)
targetName.PlaceholderText = "Nombre exacto del R15 en Animator"
targetName.Parent = root

local prompt = Instance.new("TextBox")
prompt.Name = "Prompt"
prompt.Size = UDim2.new(1, -20, 0, 36)
prompt.Position = UDim2.new(0, 10, 0, 78)
prompt.ClearTextOnFocus = false
prompt.TextXAlignment = Enum.TextXAlignment.Left
prompt.Text = "patada giratoria fuerte"
prompt.TextSize = 18
prompt.TextColor3 = Color3.new(1, 1, 1)
prompt.PlaceholderColor3 = Color3.fromRGB(220, 220, 220)
prompt.PlaceholderText = "Describe la animacion para IA"
prompt.Parent = root

local duration = Instance.new("TextBox")
duration.Name = "Duration"
duration.Size = UDim2.new(0, 120, 0, 30)
duration.Position = UDim2.new(0, 10, 0, 118)
duration.ClearTextOnFocus = false
duration.Text = "30"
duration.TextSize = 18
duration.TextColor3 = Color3.new(1, 1, 1)
duration.PlaceholderColor3 = Color3.fromRGB(220, 220, 220)
duration.PlaceholderText = "Duracion"
duration.Parent = root

local intensity = Instance.new("TextBox")
intensity.Name = "Intensity"
intensity.Size = UDim2.new(0, 120, 0, 30)
intensity.Position = UDim2.new(0, 138, 0, 118)
intensity.ClearTextOnFocus = false
intensity.Text = "0.7"
intensity.TextSize = 18
intensity.TextColor3 = Color3.new(1, 1, 1)
intensity.PlaceholderColor3 = Color3.fromRGB(220, 220, 220)
intensity.PlaceholderText = "Intensidad"
intensity.Parent = root

local generate = Instance.new("TextButton")
generate.Name = "Generate"
generate.Size = UDim2.new(0, 132, 0, 38)
generate.Position = UDim2.new(0, 10, 0, 156)
generate.Text = "Generar IA"
generate.TextSize = 14
generate.TextColor3 = Color3.new(1, 1, 1)
generate.Parent = root

local loadJson = Instance.new("TextButton")
loadJson.Name = "LoadJson"
loadJson.Size = UDim2.new(0, 132, 0, 38)
loadJson.Position = UDim2.new(0, 152, 0, 156)
loadJson.Text = "JSON to Animate"
loadJson.TextSize = 14
loadJson.TextColor3 = Color3.new(1, 1, 1)
loadJson.Parent = root

local apply = Instance.new("TextButton")
apply.Name = "ApplyPose"
apply.Size = UDim2.new(0, 156, 0, 38)
apply.Position = UDim2.new(0, 294, 0, 156)
apply.Text = "Add Keyframes"
apply.TextSize = 14
apply.TextColor3 = Color3.new(1, 1, 1)
apply.Parent = root

local jsonLabel = Instance.new("TextLabel")
jsonLabel.Name = "JsonLabel"
jsonLabel.Size = UDim2.new(1, -20, 0, 20)
jsonLabel.Position = UDim2.new(0, 10, 0, 198)
jsonLabel.BackgroundTransparency = 1
jsonLabel.TextXAlignment = Enum.TextXAlignment.Left
jsonLabel.Text = "Pega JSON y usa 'JSON to Animate' para aplicarlo"
jsonLabel.TextSize = 16
jsonLabel.TextColor3 = Color3.new(1, 1, 1)
jsonLabel.Font = Enum.Font.SourceSans
jsonLabel.Parent = root

local jsonInput = Instance.new("TextBox")
jsonInput.Name = "JsonInput"
jsonInput.Size = UDim2.new(1, -20, 0, 136)
jsonInput.Position = UDim2.new(0, 10, 0, 222)
jsonInput.ClearTextOnFocus = false
jsonInput.MultiLine = true
jsonInput.TextXAlignment = Enum.TextXAlignment.Left
jsonInput.TextYAlignment = Enum.TextYAlignment.Top
jsonInput.TextWrapped = true
jsonInput.Text = ""
jsonInput.TextSize = 12
jsonInput.Font = Enum.Font.Code
jsonInput.TextColor3 = Color3.new(1, 1, 1)
jsonInput.PlaceholderColor3 = Color3.fromRGB(220, 220, 220)
jsonInput.PlaceholderText = '{"animation_name":"combo","keyframes":[{"joint":"RightUpperArm","frame":0,"rotation":{"x":0,"y":0,"z":0},"position":{"x":0,"y":0,"z":0}}]}'
jsonInput.Parent = root

local status = Instance.new("TextLabel")
status.Name = "Status"
status.Size = UDim2.new(1, -20, 0, 60)
status.Position = UDim2.new(0, 10, 0, 362)
status.BackgroundTransparency = 1
status.TextXAlignment = Enum.TextXAlignment.Left
status.TextYAlignment = Enum.TextYAlignment.Top
status.TextWrapped = true
status.Text = "Estado: listo"
status.TextSize = 16
status.TextColor3 = Color3.new(1, 1, 1)
status.Font = Enum.Font.SourceSans
status.Parent = root

return root
end
local Win = _g.Window:new(script.Name, _g.WindowData:new("AI Fight Animator", buildContents()))

local currentAnimation = nil

do
local prompt = Win.Contents.Prompt
local targetName = Win.Contents.TargetName
local duration = Win.Contents.Duration
local intensity = Win.Contents.Intensity
local generate = Win.Contents.Generate
local loadJson = Win.Contents.LoadJson
local jsonInput = Win.Contents.JsonInput
local apply = Win.Contents.ApplyPose
local status = Win.Contents.Status

local function getAnimationFromInputs()
local rawJson = trim(jsonInput.Text)
if rawJson ~= "" then
local decoded, err = decodeAnimationText(rawJson)
if decoded == nil then
return nil, err
end
currentAnimation = decoded
return decoded
end
if currentAnimation == nil then
return nil, "primero genera la animacion o pega un JSON valido"
end
return currentAnimation
end

Win.OnOpen = function()
local moon = _g.Windows and _g.Windows.MoonAnimator
if moon and moon.g_e and moon.g_e.LayerSystem then
local active = moon.g_e.LayerSystem.LayerHandler.ActiveItemObject
if active and active.Path and active.Path.Item then
targetName.Text = active.Path.Item.Name
end
end
status.Text = "Estado: listo. Pega JSON y usa 'JSON to Animate'."
return true
end

Win.LoadExportedJSON = function(animation, encoded, mode, storagePath)
local exportAnimation = resolveAnimationTable(animation) or animation
if type(exportAnimation) ~= "table" or type(exportAnimation.keyframes) ~= "table" then
status.Text = "Estado: no se pudo cargar la exportacion"
return
end

currentAnimation = exportAnimation
jsonInput.Text = (type(encoded) == "string" and encoded ~= "") and encoded or encodeAnimationText(exportAnimation)

if type(exportAnimation.target_name) == "string" and trim(exportAnimation.target_name) ~= "" then
targetName.Text = exportAnimation.target_name
elseif type(exportAnimation.animation_name) == "string" and trim(exportAnimation.animation_name) ~= "" then
targetName.Text = exportAnimation.animation_name
end

local modeText = mode == "selected" and "seleccion" or "rig activo"
status.Text = "Estado: timeline -> JSON ("..modeText..") listo. Keyframes: "..tostring(#exportAnimation.keyframes)..". StringValue: "..tostring(storagePath or "no guardado")
end

generate.MouseButton1Click:Connect(function()
local promptText = trim(prompt.Text)
local targetText = trim(targetName.Text)
if promptText == "" then
status.Text = "Estado: escribe un prompt primero"
return
end
if targetText == "" then
status.Text = "Estado: escribe el nombre exacto objetivo"
return
end

status.Text = "Estado: generando animacion IA..."
task.spawn(function()
local result = requestAnimation(
promptText,
toNumberOrDefault(duration.Text, 30),
toNumberOrDefault(intensity.Text, 0.7),
targetText
)

if result and result.success and result.animation then
currentAnimation = result.animation
jsonInput.Text = encodeAnimationText(currentAnimation)
status.Text = "Estado: IA generada. Puedes editar el JSON o pulsar 'JSON to Animate'."
else
status.Text = "Estado: error al generar. Revisa servidor en :8000"
end
end)
end)

loadJson.MouseButton1Click:Connect(function()
local decoded, err = decodeAnimationText(jsonInput.Text)
if decoded == nil then
status.Text = "Estado: "..err
return
end
currentAnimation = decoded
status.Text = "Estado: JSON cargado. Pulsa 'Add Keyframes' o 'JSON to Animate' para insertarlo."
end)

apply.MouseButton1Click:Connect(function()
local moon = _g.Windows and _g.Windows.MoonAnimator
if not (moon and moon.g_e and moon.g_e.LayerSystem and moon.DoCompositeAction) then
status.Text = "Estado: Animator no esta listo"
return
end

local animation, animationErr = getAnimationFromInputs()
if animation == nil then
status.Text = "Estado: "..animationErr
return
end

local targetText = trim(targetName.Text)
local layerSystem = moon.g_e.LayerSystem
if targetText == "" then
local active = layerSystem.LayerHandler and layerSystem.LayerHandler.ActiveItemObject
if active and active.Path and active.Path.Item then
targetText = active.Path.Item.Name
targetName.Text = targetText
else
status.Text = "Estado: selecciona un personaje o escribe un nombre objetivo"
return
end
end

local itemObject = findItemObjectByName(layerSystem, targetText)
if itemObject == nil then
status.Text = "Estado: no existe objeto con nombre exacto '"..targetText.."'"
return
end

if itemObject.RigMap == nil then
status.Text = "Estado: objeto sin rig R15"
return
end

local keyframes = collectTargetKeyframes(animation)
if #keyframes == 0 then
status.Text = "Estado: animacion sin keyframes"
return
end

-- Verificar integridad de keyframes
local isComplete = validateKeyframeIntegrity(animation)
if isComplete then
status.Text = "Estado: keyframes completos detectados. Procesando sin modificaciones..."
else
status.Text = "Estado: aviso - algunos keyframes pueden estar incompletos, generando..."
end

local startFrame = layerSystem.SliderFrame
local created = 0
local skipped = 0
local baseByTrack = {}
local frameBuckets = {}
local frameOrder = {}

for _, kf in pairs(keyframes) do
local jointName = trim(kf.joint)
local track = findRigTrack(itemObject.RigMap, jointName)
if track == nil then
skipped = skipped + 1
continue
end

local frameOffset = tonumber(kf.frame) or 0
local targetFrame = math.max(0, math.floor(startFrame + frameOffset + 0.5))
local rot = type(kf.rotation) == "table" and kf.rotation or {}
local rx = tonumber(rot.x) or 0
local ry = tonumber(rot.y) or 0
local rz = tonumber(rot.z) or 0

local pos = type(kf.position) == "table" and kf.position or {}
local px = tonumber(pos.x) or 0
local py = tonumber(pos.y) or 0
local pz = tonumber(pos.z) or 0

local baseCFrame = baseByTrack[track]
if baseCFrame == nil then
baseCFrame = track.defaultValue or track:get_prop()
if typeof(baseCFrame) ~= "CFrame" then
skipped = skipped + 1
continue
end
baseByTrack[track] = baseCFrame
end

-- Componer CFrame: posicion * rotacion relativo a la pose base del joint
-- Los valores del JSON (px, py, pz, rx, ry, rz) son OFFSETS desde la pose T (pose neutra)
-- El resultado es una pose absoluta que Animator almacenara
local desired = baseCFrame * CFrame.new(px, py, pz) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
local bucket = frameBuckets[targetFrame]
if bucket == nil then
bucket = {Tracks = {}, Lookup = {}, Values = {}}
frameBuckets[targetFrame] = bucket
table.insert(frameOrder, targetFrame)
end

local trackKey = tostring(track)
if not bucket.Lookup[trackKey] then
bucket.Lookup[trackKey] = true
table.insert(bucket.Tracks, track)
end
bucket.Values[trackKey] = desired
end

table.sort(frameOrder)

for _, frame in ipairs(frameOrder) do
local bucket = frameBuckets[frame]
layerSystem:SetSliderFrame(frame)
for _, track in ipairs(bucket.Tracks) do
track:set_prop(bucket.Values[tostring(track)])
end
moon.DoCompositeAction("AddToTracks", {Tracks = bucket.Tracks})
created = created + #bucket.Tracks
end

layerSystem:SetSliderFrame(startFrame)

-- Mensaje de exito mas detallado
if isComplete then
status.Text = "Estado: [OK] keyframes EXACTOS aplicados "..tostring(created).." en '"..targetText.."' (omitidos: "..tostring(skipped)..")."
else
status.Text = "Estado: keyframes creados "..tostring(created).." en '"..targetText.."' (omitidos: "..tostring(skipped)..")."
end
end)
end

return Win]]></ProtectedString>
